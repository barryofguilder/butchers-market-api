{
  "name": "butchers-market-api",
  "version": "3.0.0",
  "main": "src/index.ts",
  "author": "Jason Barry <jbarry@hey.com>",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "node dist/index.cjs",
    "db:create": "sequelize-cli db:create",
    "db:migrate": "sequelize-cli db:migrate",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo",
    "db:unseed": "sequelize-cli db:seed:undo:all",
    "lint": "eslint . --cache",
    "test": "vitest run",
    "test:watch": "vitest",
    "prettier": "prettier --write \"**/*.js\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.712.0",
    "@aws-sdk/lib-storage": "^3.712.0",
    "@koa/cors": "^5.0.0",
    "@koa/router": "^15.7.0",
    "dotenv": "^16.4.7",
    "jsonwebtoken": "^9.0.2",
    "koa": "^3.2.1",
    "koa-body": "^8.0.1",
    "koa-jwt": "^4.0.4",
    "koa-logger": "^4.0.0",
    "pg": "^8.13.1",
    "sequelize": "^6.37.5"
  },
  "devDependencies": {
    "@types/koa": "^3.0.3",
    "@types/koa__cors": "^5.0.1",
    "@types/koa-logger": "^3.1.5",
    "@types/node": "^22.10.2",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-n": "^17.15.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "3.4.2",
    "sequelize-cli": "^6.6.2",
    "sqlite3": "^6.0.1",
    "supertest": "^7.3.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.2",
    "vite-plugin-node": "^8.0.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "22.12.0"
  },
  "volta": {
    "node": "22.12.0"
  }
}
